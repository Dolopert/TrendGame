# ฐานข้อมูลตัวจริงเป็นไฟล์ไบนารี ไม่เก็บใน git
# ประวัติเก็บเป็น data/radar.sql แทน แล้วสร้างกลับด้วย `game-radar restore`
data/*.sqlite3
data/*.sqlite3-*
out/
.venv/
__pycache__/
*.pyc
update_market.log

# คีย์ API ของ 499k — ห้ามขึ้น git เด็ดขาด
# (quantpath เคยมีเหตุคีย์หลุดจนต้อง rebuild git history ทั้งสาย)
#
# ดักทุกนามสกุล ไม่ใช่แค่ .env เป๊ะ ๆ เพราะ Notepad บน Windows เติม .txt
# ให้เองเวลา Save As — เคยได้ .env.txt ที่หลุดกฎเดิมมาแล้วจริง ๆ
.env*
!.env.example

# สต็อกไอดีของร้าน — มีอีเมล ชื่อล็อกอิน และชื่อลูกค้า
# repo นี้เป็น public และ data/radar.sql ถูก commit ทุกคืน ถ้าไฟล์พวกนี้หลุดเข้าไป
# จะขึ้น GitHub ให้คนทั้งโลกอ่าน (data/*.sqlite3 ดักตัวฐานข้อมูลไว้แล้ว
# บรรทัดนี้ดักไฟล์ส่งออกและไฟล์สำรองที่คนเผลอวางไว้ในโปรเจกต์)
data/stock.*
data/own.*
account.csv
license.csv
rental.csv

# ผลดิบจาก probe — มีข้อมูลร้าน ไม่ต้องขึ้น git
probe_499k_result.json
